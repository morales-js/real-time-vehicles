PORT=4000
JWT_SECRET=cambia-este-secreto

# Opción A: parámetros sueltos
DB_SERVER=127.0.0.1
DB_PORT=1433
DB_NAME=SubastasDB
DB_USER=subastas_app
DB_PASSWORD=tu-clave
DB_ENCRYPT=false

# Opción B (Azure SQL): cadena de conexión completa. Si existe, tiene prioridad.
# SQL_CONNECTION_STRING=Server=tcp:<servidor>.database.windows.net,1433;Initial Catalog=SubastasDB;User ID=<usuario>;Password=<clave>;Encrypt=True;TrustServerCertificate=False;Connection Timeout=60;

AUTO_SEED=true
# Solo si el frontend se publica en otro dominio (p. ej. Static Web Apps). Separar con comas.
# CORS_ORIGIN=https://mi-front.azurestaticapps.net
